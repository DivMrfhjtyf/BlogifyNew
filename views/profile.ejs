<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <%- include("./partials/head") %>
    <title><%= user.fullName %> - Profile | Blogify</title>
    <style>
        :root {
            --primary: #6366f1;
            --primary-dark: #4f46e5;
            --primary-soft: #e0e7ff;
            --bg: #f8fafc;
            --surface: #ffffff;
            --text: #1e293b;
            --text-secondary: #64748b;
            --border: #e2e8f0;
            --danger: #dc2626;
            --success: #16a34a;
            --warning: #f59e0b;
            --shadow: 0 4px 20px rgba(0,0,0,0.06);
            --shadow-lg: 0 10px 40px rgba(0,0,0,0.1);
            --radius: 16px;
        }
        [data-theme="dark"] {
            --bg: #0f0f1a;
            --surface: #1a1a2e;
            --text: #f1f5f9;
            --text-secondary: #94a3b8;
            --border: #2d2d44;
            --primary-soft: #1e1b4b;
            --shadow: 0 4px 20px rgba(0,0,0,0.3);
            --shadow-lg: 0 10px 40px rgba(0,0,0,0.4);
        }
        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Inter', -apple-system, sans-serif;
            padding-top: 80px;
        }

        /* Profile Header */
        .profile-header {
            background: linear-gradient(135deg, var(--primary-soft), var(--bg));
            border-bottom: 1px solid var(--border);
            padding: 48px 0 32px;
            margin-bottom: 32px;
        }
        .profile-header-inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 24px;
            display: flex;
            align-items: center;
            gap: 32px;
            flex-wrap: wrap;
        }
        .profile-avatar {
            position: relative;
            flex-shrink: 0;
        }
        .profile-avatar img {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            object-fit: cover;
            border: 5px solid var(--surface);
            box-shadow: var(--shadow-lg);
        }
        .profile-info {
            flex: 1;
            min-width: 260px;
        }
        .profile-name {
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        .profile-email {
            color: var(--text-secondary);
            font-size: 0.95rem;
            margin-bottom: 12px;
        }
        .profile-bio {
            font-size: 1rem;
            line-height: 1.6;
            margin-bottom: 16px;
            max-width: 600px;
        }
        .profile-website {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--primary);
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 20px;
            transition: all 0.2s;
        }
        .profile-website:hover {
            border-color: var(--primary);
            transform: translateY(-2px);
            box-shadow: var(--shadow);
        }
        .profile-stats {
            display: flex;
            gap: 32px;
            flex-wrap: wrap;
        }
        .stat-item {
            text-align: center;
        }
        .stat-value {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--primary);
        }
        .stat-label {
            font-size: 0.85rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .profile-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-left: auto;
            align-self: flex-start;
        }
        .btn-profile {
            padding: 12px 24px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 0.95rem;
            cursor: pointer;
            transition: all 0.2s;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }
        .btn-profile-primary {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            box-shadow: 0 4px 15px rgba(99,102,241,0.3);
        }
        .btn-profile-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(99,102,241,0.4);
        }
        .btn-profile-outline {
            background: var(--surface);
            color: var(--primary);
            border: 2px solid var(--primary);
        }
        .btn-profile-outline:hover {
            background: var(--primary);
            color: white;
        }

        /* Tabs */
        .tabs-wrapper {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 24px;
        }
        .tabs-nav {
            display: flex;
            gap: 8px;
            border-bottom: 2px solid var(--border);
            margin-bottom: 32px;
            overflow-x: auto;
            padding-bottom: 2px;
        }
        .tab-btn {
            padding: 14px 24px;
            background: none;
            border: none;
            color: var(--text-secondary);
            font-weight: 600;
            font-size: 0.95rem;
            cursor: pointer;
            border-bottom: 3px solid transparent;
            margin-bottom: -2px;
            white-space: nowrap;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
        }
        .tab-btn:hover {
            color: var(--primary);
        }
        .tab-btn.active {
            color: var(--primary);
            border-bottom-color: var(--primary);
        }

        /* Tab Panes */
        .tab-pane {
            display: none;
            animation: fadeIn 0.3s ease;
        }
        .tab-pane.active {
            display: block;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Blog Cards */
        .blogs-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
            gap: 24px;
        }
        .blog-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            position: relative;
        }
        .blog-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
        }
        .blog-card-image-wrap {
            position: relative;
            height: 200px;
            overflow: hidden;
            background: var(--bg);
        }
        .blog-card-image-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }
        .blog-card:hover .blog-card-image-wrap img {
            transform: scale(1.05);
        }
        .blog-card-image-placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-secondary);
        }
        .blog-badges {
            position: absolute;
            top: 12px;
            right: 12px;
            display: flex;
            gap: 8px;
        }
        .badge {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
        }
        .badge-draft { background: var(--warning); color: #1e293b; }
        .badge-featured { background: var(--success); color: white; }
        .blog-dropdown {
            position: absolute;
            top: 12px;
            left: 12px;
        }
        .blog-dropdown-btn {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: rgba(0,0,0,0.6);
            border: none;
            color: white;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(4px);
        }
        .blog-dropdown-menu {
            position: absolute;
            top: 44px;
            left: 0;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: var(--shadow-lg);
            min-width: 160px;
            overflow: hidden;
            z-index: 100;
            display: none;
        }
        .blog-dropdown-menu.show { display: block; }
        .blog-dropdown-menu a, .blog-dropdown-menu button {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 16px;
            color: var(--text);
            text-decoration: none;
            font-size: 0.9rem;
            background: none;
            border: none;
            width: 100%;
            cursor: pointer;
            font-family: inherit;
            transition: background 0.2s;
        }
        .blog-dropdown-menu a:hover, .blog-dropdown-menu button:hover {
            background: var(--primary-soft);
        }
        .blog-dropdown-menu .text-danger { color: var(--danger); }
        .blog-dropdown-divider {
            height: 1px;
            background: var(--border);
            margin: 4px 0;
        }
        .blog-card-body {
            padding: 20px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        .blog-card-title {
            font-size: 1.15rem;
            font-weight: 700;
            margin-bottom: 10px;
            line-height: 1.4;
        }
        .blog-card-tags {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            margin-bottom: 12px;
        }
        .tag-badge {
            padding: 4px 10px;
            background: var(--primary-soft);
            color: var(--primary);
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 600;
        }
        .blog-card-excerpt {
            color: var(--text-secondary);
            font-size: 0.9rem;
            line-height: 1.5;
            flex: 1;
            margin-bottom: 16px;
        }
        .blog-card-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 16px;
            border-top: 1px solid var(--border);
            font-size: 0.85rem;
            color: var(--text-secondary);
        }
        .blog-card-meta {
            display: flex;
            gap: 16px;
        }
        .blog-card-meta span {
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .btn-read {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 16px;
            padding: 10px 20px;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.9rem;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-read:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(99,102,241,0.3);
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 80px 20px;
        }
        .empty-state i {
            font-size: 4rem;
            color: var(--border);
            margin-bottom: 20px;
        }
        .empty-state h3 {
            color: var(--text-secondary);
            font-weight: 600;
            margin-bottom: 16px;
        }

        /* Followers / Following Grid */
        .users-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
        }
        .user-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 24px;
            text-align: center;
            box-shadow: var(--shadow);
            transition: all 0.2s;
        }
        .user-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }
        .user-card img {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            object-fit: cover;
            margin-bottom: 12px;
            border: 3px solid var(--primary-soft);
        }
        .user-card h5 {
            font-weight: 700;
            margin-bottom: 6px;
        }
        .user-card p {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-bottom: 16px;
            min-height: 20px;
        }
        .btn-follow-sm {
            width: 100%;
            padding: 10px;
            border-radius: 10px;
            border: 2px solid var(--primary);
            background: transparent;
            color: var(--primary);
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        .btn-follow-sm:hover, .btn-follow-sm.following {
            background: var(--primary);
            color: white;
        }

        /* Analytics */
        .analytics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }
        .analytics-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 28px 20px;
            text-align: center;
            box-shadow: var(--shadow);
            transition: all 0.2s;
        }
        .analytics-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }
        .analytics-card i {
            font-size: 2.5rem;
            margin-bottom: 12px;
        }
        .analytics-card h6 {
            font-size: 0.85rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 8px;
        }
        .analytics-card h3 {
            font-size: 2rem;
            font-weight: 800;
        }
        .text-primary { color: var(--primary); }
        .text-success { color: var(--success); }
        .text-danger { color: #ef4444; }
        .text-info { color: #0ea5e9; }

        /* Toast */
        .toast-container {
            position: fixed;
            top: 90px;
            right: 20px;
            z-index: 3000;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .toast {
            padding: 16px 24px;
            border-radius: 14px;
            color: white;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 12px;
            transform: translateX(120%);
            transition: transform 0.4s cubic-bezier(0.4,0,0.2,1);
            box-shadow: var(--shadow-lg);
            max-width: 380px;
        }
        .toast.show { transform: translateX(0); }
        .toast.success { background: linear-gradient(135deg, #16a34a, #22c55e); }
        .toast.error { background: linear-gradient(135deg, #dc2626, #ef4444); }

        @media (max-width: 768px) {
            .profile-header-inner { flex-direction: column; text-align: center; }
            .profile-stats { justify-content: center; }
            .profile-actions { margin: 0 auto; }
            .blogs-grid { grid-template-columns: 1fr; }
            .users-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <%- include("./partials/nave") %>

    <%
        const isOwnProfile = locals.user && locals.user._id.toString() === user._id.toString();
    %>

    <!-- Profile Header -->
    <div class="profile-header">
        <div class="profile-header-inner">
            <div class="profile-avatar">
                <img src="<%= user.profileImageURL || '/imgs/default.png' %>" 
                     alt="<%= user.fullName %>" 
                     onerror="this.src='/imgs/default.png';">
            </div>
            <div class="profile-info">
                <div class="profile-name">
                    <%= user.fullName %>
                    <% if (user.role === 'ADMIN') { %>
                        <span class="badge" style="background: var(--primary); color: white; font-size: 0.7rem; padding: 4px 10px;">ADMIN</span>
                    <% } %>
                </div>
                <div class="profile-email"><%= user.email %></div>
                <% if (user.bio) { %>
                    <div class="profile-bio"><%= user.bio %></div>
                <% } %>
                <% if (user.website) { %>
                    <a href="<%= user.website %>" target="_blank" class="profile-website">
                        <i class="fas fa-globe"></i> Visit Website
                    </a>
                <% } %>
                <div class="profile-stats">
                    <div class="stat-item">
                        <div class="stat-value"><%= blogs ? blogs.length : 0 %></div>
                        <div class="stat-label">Blogs</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value"><%= user.followers ? user.followers.length : 0 %></div>
                        <div class="stat-label">Followers</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value"><%= user.following ? user.following.length : 0 %></div>
                        <div class="stat-label">Following</div>
                    </div>
                </div>
            </div>
            <div class="profile-actions">
                <% if (isOwnProfile) { %>
                    <a href="/user/profile/settings" class="btn-profile btn-profile-primary">
                        <i class="fas fa-cog"></i> Settings
                    </a>
                <% } else if (locals.user) { %>
                    <button class="btn-profile btn-profile-outline" id="followBtn" onclick="toggleFollow()">
                        <i class="fas fa-user-plus"></i> Follow
                    </button>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <div class="tabs-wrapper">
        <div class="tabs-nav">
            <button class="tab-btn active" onclick="switchTab('blogs', this)">
                <i class="fas fa-book"></i> Blogs
            </button>
            <button class="tab-btn" onclick="switchTab('followers', this)">
                <i class="fas fa-users"></i> Followers
            </button>
            <button class="tab-btn" onclick="switchTab('following', this)">
                <i class="fas fa-heart"></i> Following
            </button>
            <% if (isOwnProfile) { %>
                <button class="tab-btn" onclick="switchTab('analytics', this)">
                    <i class="fas fa-chart-line"></i> Analytics
                </button>
            <% } %>
        </div>

        <!-- Blogs Tab -->
        <div class="tab-pane active" id="tab-blogs">
            <% if (!blogs || blogs.length === 0) { %>
                <div class="empty-state">
                    <i class="fas fa-inbox"></i>
                    <h3>No blogs published yet</h3>
                    <% if (isOwnProfile) { %>
                        <a href="/blogs/add-new" class="btn-profile btn-profile-primary">
                            <i class="fas fa-pen"></i> Write First Blog
                        </a>
                    <% } %>
                </div>
            <% } else { %>
                <div class="blogs-grid">
                    <% blogs.forEach(blog => { %>
                        <div class="blog-card">
                            <div class="blog-card-image-wrap">
                                <% if (blog.coverImageURL) { %>
                                    <img src="<%= blog.coverImageURL %>" alt="<%= blog.title %>" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                    <div class="blog-card-image-placeholder" style="display:none;">
                                        <i class="fas fa-image fa-3x"></i>
                                    </div>
                                <% } else { %>
                                    <div class="blog-card-image-placeholder">
                                        <i class="fas fa-image fa-3x"></i>
                                    </div>
                                <% } %>

                                <div class="blog-badges">
                                    <% if (blog.status === 'draft') { %>
                                        <span class="badge badge-draft">Draft</span>
                                    <% } else if (blog.isFeatured) { %>
                                        <span class="badge badge-featured">Featured</span>
                                    <% } %>
                                </div>

                                <% if (isOwnProfile) { %>
                                    <div class="blog-dropdown">
                                        <button class="blog-dropdown-btn" onclick="toggleDropdown(this)">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <div class="blog-dropdown-menu">
                                            <a href="/blogs/<%= blog._id %>"><i class="fas fa-eye"></i> View</a>
                                            <a href="/blogs/<%= blog._id %>/edit"><i class="fas fa-edit"></i> Edit</a>
                                            <div class="blog-dropdown-divider"></div>
                                            <button class="text-danger" onclick="deleteBlog('<%= blog._id %>')">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        </div>
                                    </div>
                                <% } %>
                            </div>

                            <div class="blog-card-body">
                                <div class="blog-card-title"><%= truncate(blog.title, 60) %></div>
                                <% if (blog.tags && blog.tags.length > 0) { %>
                                    <div class="blog-card-tags">
                                        <% blog.tags.slice(0, 3).forEach(tag => { %>
                                            <span class="tag-badge"><%= tag %></span>
                                        <% }) %>
                                    </div>
                                <% } %>
                                <div class="blog-card-excerpt">
                                    <%= truncate(blog.excerpt || (blog.body ? blog.body.substring(0, 120) : ''), 100) %>
                                </div>
                                <div class="blog-card-footer">
                                    <span><i class="fas fa-calendar"></i> <%= formatDate(blog.createdAt) %></span>
                                    <div class="blog-card-meta">
                                        <span><i class="fas fa-eye"></i> <%= blog.viewCount || 0 %></span>
                                        <span><i class="fas fa-heart"></i> <%= blog.likes ? blog.likes.length : 0 %></span>
                                    </div>
                                </div>
                                <a href="/blogs/<%= blog._id %>" class="btn-read">
                                    <i class="fas fa-arrow-right"></i> Read Blog
                                </a>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- Followers Tab -->
        <div class="tab-pane" id="tab-followers">
            <% if (!user.followers || user.followers.length === 0) { %>
                <div class="empty-state">
                    <i class="fas fa-user-friends"></i>
                    <h3>No followers yet</h3>
                </div>
            <% } else { %>
                <div class="users-grid">
                    <% user.followers.forEach(follower => { %>
                        <div class="user-card">
                            <img src="<%= follower.profileImageURL || '/imgs/default.png' %>" alt="<%= follower.fullName %>" onerror="this.src='/imgs/default.png';">
                            <h5><%= follower.fullName %></h5>
                            <p><%= follower.bio || 'No bio yet' %></p>
                            <% if (locals.user && follower._id.toString() !== locals.user._id.toString()) { %>
                                <button class="btn-follow-sm" onclick="toggleFollowUser('<%= follower._id %>', this)">
                                    <i class="fas fa-user-plus"></i> Follow Back
                                </button>
                            <% } %>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- Following Tab -->
        <div class="tab-pane" id="tab-following">
            <% if (!user.following || user.following.length === 0) { %>
                <div class="empty-state">
                    <i class="fas fa-heart"></i>
                    <h3>Not following anyone yet</h3>
                </div>
            <% } else { %>
                <div class="users-grid">
                    <% user.following.forEach(followee => { %>
                        <div class="user-card">
                            <img src="<%= followee.profileImageURL || '/imgs/default.png' %>" alt="<%= followee.fullName %>" onerror="this.src='/imgs/default.png';">
                            <h5><%= followee.fullName %></h5>
                            <p><%= followee.bio || 'No bio yet' %></p>
                            <% if (locals.user && followee._id.toString() !== locals.user._id.toString()) { %>
                                <button class="btn-follow-sm following" onclick="toggleFollowUser('<%= followee._id %>', this)">
                                    <i class="fas fa-user-check"></i> Following
                                </button>
                            <% } %>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- Analytics Tab -->
        <% if (isOwnProfile) { %>
            <div class="tab-pane" id="tab-analytics">
                <div class="analytics-grid">
                    <div class="analytics-card">
                        <i class="fas fa-book text-primary"></i>
                        <h6>Total Blogs</h6>
                        <h3 class="text-primary" id="statBlogs">—</h3>
                    </div>
                    <div class="analytics-card">
                        <i class="fas fa-eye text-success"></i>
                        <h6>Total Views</h6>
                        <h3 class="text-success" id="statViews">—</h3>
                    </div>
                    <div class="analytics-card">
                        <i class="fas fa-heart text-danger"></i>
                        <h6>Total Likes</h6>
                        <h3 class="text-danger" id="statLikes">—</h3>
                    </div>
                    <div class="analytics-card">
                        <i class="fas fa-comment text-info"></i>
                        <h6>Total Comments</h6>
                        <h3 class="text-info" id="statComments">—</h3>
                    </div>
                </div>
            </div>
        <% } %>
    </div>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>

    <%- include("./partials/scripts") %>

    <script>
        const profileUserId = '<%= user._id %>';
        const currentUserId = '<%= locals.user ? locals.user._id : "" %>';

        // Theme sync
        const savedTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);

        // Tabs
        function switchTab(tabId, btn) {
            document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('tab-' + tabId).classList.add('active');
            btn.classList.add('active');
            if (tabId === 'analytics') loadAnalytics();
        }

        // Toast
        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            toast.innerHTML = `<i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'}"></i> ${message}`;
            container.appendChild(toast);
            setTimeout(() => toast.classList.add('show'), 10);
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 400);
            }, 4000);
        }

        // Dropdown
        function toggleDropdown(btn) {
            const menu = btn.nextElementSibling;
            const isOpen = menu.classList.contains('show');
            document.querySelectorAll('.blog-dropdown-menu').forEach(m => m.classList.remove('show'));
            if (!isOpen) menu.classList.add('show');
        }
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.blog-dropdown')) {
                document.querySelectorAll('.blog-dropdown-menu').forEach(m => m.classList.remove('show'));
            }
        });

        // Delete Blog
        async function deleteBlog(id) {
            if (!confirm('Are you sure you want to delete this blog?')) return;
            try {
                const res = await axios.delete(`/blogs/${id}`);
                if (res.data.success) {
                    showToast('Blog deleted successfully!');
                    setTimeout(() => location.reload(), 1500);
                }
            } catch (err) {
                showToast('Failed to delete blog', 'error');
            }
        }

        // Follow / Unfollow (Profile Page Button)
        async function toggleFollow() {
            if (!currentUserId) { window.location.href = '/user/signin'; return; }
            try {
                const res = await axios.post(`/follow/${profileUserId}/follow`);
                if (res.data.success) {
                    showToast(res.data.message);
                    const btn = document.getElementById('followBtn');
                    if (res.data.following) {
                        btn.innerHTML = '<i class="fas fa-user-check"></i> Following';
                        btn.classList.replace('btn-profile-outline', 'btn-profile-primary');
                    } else {
                        btn.innerHTML = '<i class="fas fa-user-plus"></i> Follow';
                        btn.classList.replace('btn-profile-primary', 'btn-profile-outline');
                    }
                }
            } catch (err) {
                showToast('Failed to follow user', 'error');
            }
        }

        // Follow / Unfollow (User Cards)
        async function toggleFollowUser(targetId, btn) {
            if (!currentUserId) { window.location.href = '/user/signin'; return; }
            try {
                const res = await axios.post(`/follow/${targetId}/follow`);
                if (res.data.success) {
                    showToast(res.data.message);
                    if (res.data.following) {
                        btn.innerHTML = '<i class="fas fa-user-check"></i> Following';
                        btn.classList.add('following');
                    } else {
                        btn.innerHTML = '<i class="fas fa-user-plus"></i> Follow Back';
                        btn.classList.remove('following');
                    }
                }
            } catch (err) {
                showToast('Failed to update follow status', 'error');
            }
        }

        // Load Analytics
        async function loadAnalytics() {
            try {
                const res = await axios.get('/analytics/author/stats');
                if (res.data.success) {
                    const s = res.data.stats;
                    document.getElementById('statBlogs').textContent = s.totalBlogs ?? 0;
                    document.getElementById('statViews').textContent = s.totalViews ?? 0;
                    document.getElementById('statLikes').textContent = s.totalLikes ?? 0;
                    document.getElementById('statComments').textContent = s.totalComments ?? 0;
                }
            } catch (err) {
                console.error('Analytics load error:', err);
            }
        }
    </script>
</body>
</html>

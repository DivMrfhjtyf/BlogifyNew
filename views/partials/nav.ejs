<!-- Modern Premium Navigation -->
<nav class="main-nav" id="mainNav">
    <div class="nav-container">
        <a href="/" class="nav-brand">
            <div class="brand-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 19l7-7 3 3-7 7-3-3z"/>
                    <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/>
                    <path d="M2 2l7.586 7.586"/>
                    <circle cx="11" cy="11" r="2"/>
                </svg>
            </div>
            <span class="brand-text">Blogify</span>
        </a>
        <div class="nav-links-desktop">
            <a href="/" class="nav-link <%= locals.activePage === 'home' ? 'active' : '' %>">
                <i class="fas fa-compass"></i><span>Explore</span>
            </a>
            <% if (locals.user) { %>
                <a href="/blogs/add-new" class="nav-link"><i class="fas fa-pen-nib"></i><span>Write</span></a>
                <a href="/profile/<%= locals.user._id %>" class="nav-link"><i class="fas fa-layer-group"></i><span>My Blogs</span></a>
            <% } %>
        </div>
        <div class="nav-actions">
            <button class="nav-btn search-toggle" id="searchToggle" title="Search"><i class="fas fa-search"></i></button>
            <% if (locals.user) { %>
                <button class="nav-btn theme-btn" id="themeToggle" title="Toggle Theme"><i class="fas fa-moon" id="themeIcon"></i></button>
                <div class="user-menu">
                    <button class="user-trigger" id="userMenuTrigger">
                        <img src="<%= locals.user.profileImageURL || '/imgs/default.png' %>" alt="<%= locals.user.fullName %>" onerror="this.src='/imgs/default.png';">
                    </button>
                    <div class="user-dropdown" id="userDropdown">
                        <div class="dropdown-header">
                            <img src="<%= locals.user.profileImageURL || '/imgs/default.png' %>" alt="<%= locals.user.fullName %>" onerror="this.src='/imgs/default.png';">
                            <div><h4><%= locals.user.fullName %></h4><p>@<%= locals.user.email.split('@')[0] %></p></div>
                        </div>
                        <div class="dropdown-footer" style="border-top:none;padding-top:0;">
                            <a href="/user/logout" class="logout-btn"><i class="fas fa-sign-out-alt"></i><span>Sign Out</span></a>
                        </div>
                    </div>
                </div>
                <button class="nav-btn options-toggle" id="optionsToggle" title="Menu"><i class="fas fa-bars"></i></button>
            <% } else { %>
                <div class="auth-buttons">
                    <a href="/user/signin" class="btn-signin">Sign In</a>
                    <a href="/user/signup" class="btn-signup">Get Started</a>
                </div>
                <button class="mobile-toggle" id="mobileToggle"><span></span><span></span><span></span></button>
            <% } %>
        </div>
    </div>
    <div class="search-overlay" id="searchOverlay">
        <div class="search-container">
            <i class="fas fa-search search-icon"></i>
            <form method="GET" action="/"><input type="search" name="search" placeholder="Search articles, topics, authors..." autofocus></form>
            <button class="search-close" id="searchClose"><i class="fas fa-times"></i></button>
        </div>
        <div class="search-backdrop"></div>
    </div>
</nav>

<div class="options-drawer" id="optionsDrawer">
    <div class="drawer-header">
        <span class="drawer-title">Menu</span>
        <button class="drawer-close" id="drawerClose"><i class="fas fa-times"></i></button>
    </div>
    <div class="drawer-body">
        <% if (locals.user) { %>
            <a href="/notifications" class="drawer-item">
                <div class="drawer-icon purple"><i class="fas fa-bell"></i></div>
                <span>Notifications</span>
                <span class="drawer-badge" id="drawerNotifBadge" style="display:none;">0</span>
            </a>
            <a href="/profile/<%= locals.user._id %>" class="drawer-item">
                <div class="drawer-icon blue"><i class="fas fa-user"></i></div>
                <span>Profile Visit</span>
            </a>
            <a href="/profile/<%= locals.user._id %>?tab=analytics" class="drawer-item">
                <div class="drawer-icon orange"><i class="fas fa-chart-line"></i></div>
                <span>Analytics</span>
            </a>
            <div class="drawer-divider"></div>
            <div class="drawer-section-title"><i class="fas fa-cog"></i> Settings</div>
            <a href="/blogs/add-new" class="drawer-item">
                <div class="drawer-icon green"><i class="fas fa-pen"></i></div>
                <span>Post Blog</span>
            </a>
            <a href="/user/profile/settings" class="drawer-item">
                <div class="drawer-icon purple"><i class="fas fa-cog"></i></div>
                <span>Settings</span>
            </a>
            <div class="drawer-accordion">
                <button class="drawer-accordion-trigger" onclick="toggleAccordion(this)">
                    <div class="drawer-icon yellow"><i class="fas fa-envelope"></i></div>
                    <span>Notification Preferences</span>
                    <i class="fas fa-chevron-down accordion-arrow"></i>
                </button>
                <div class="drawer-accordion-content">
                    <label class="drawer-check-row">
                        <span>Email when someone comments</span>
                    </label>
                    <label class="drawer-check-row">
                        <span>Email when someone follows me</span>
                    </label>
                    <label class="drawer-check-row">
                        <span>Email when someone likes my blog</span>
                    </label>
                    <label class="drawer-check-row">
                        <span>Weekly digest of activity</span>
                    </label>
                    <button class="drawer-save-btn" onclick="saveNotifPrefs()"><i class="fas fa-save"></i> Save Preferences</button>
                </div>
            </div>
            <div class="drawer-accordion">
                <button class="drawer-accordion-trigger" onclick="toggleAccordion(this)">
                    <div class="drawer-icon red"><i class="fas fa-shield-alt"></i></div>
                    <span>Privacy & Security</span>
                    <i class="fas fa-chevron-down accordion-arrow"></i>
                </button>
                <div class="drawer-accordion-content">
                    <a href="/user/profile/settings" class="drawer-sub-item"><i class="fas fa-lock"></i> Change Password</a>
                    <a href="/user/profile/settings" class="drawer-sub-item"><i class="fas fa-user-edit"></i> Edit Name</a>
                    <a href="/user/profile/settings" class="drawer-sub-item text-danger"><i class="fas fa-trash"></i> Delete Account</a>
                </div>
            </div>
            <% if (locals.user.role === "ADMIN") { %>
                <div class="drawer-divider"></div>
                <a href="/admin/users" class="drawer-item">
                    <div class="drawer-icon red"><i class="fas fa-shield-alt"></i></div>
                    <span>Admin Panel</span>
                </a>
            <% } %>
            <div class="drawer-divider"></div>
            <a href="/user/logout" class="drawer-item text-danger">
                <div class="drawer-icon gray"><i class="fas fa-sign-out-alt"></i></div>
                <span>Sign Out</span>
            </a>
        <% } else { %>
            <a href="/user/signin" class="drawer-item"><div class="drawer-icon blue"><i class="fas fa-sign-in-alt"></i></div><span>Sign In</span></a>
            <a href="/user/signup" class="drawer-item"><div class="drawer-icon green"><i class="fas fa-rocket"></i></div><span>Get Started</span></a>
        <% } %>
    </div>
</div>
<div class="drawer-backdrop" id="drawerBackdrop"></div>

<div class="mobile-menu" id="mobileMenu">
    <div class="mobile-header"><span class="mobile-title">Menu</span><button class="mobile-close" id="mobileClose"><i class="fas fa-times"></i></button></div>
    <div class="mobile-links">
        <a href="/" class="mobile-link"><i class="fas fa-compass"></i><span>Explore</span></a>
        <% if (!locals.user) { %>
            <div class="mobile-divider"></div>
            <a href="/user/signin" class="mobile-link"><i class="fas fa-sign-in-alt"></i><span>Sign In</span></a>
            <a href="/user/signup" class="mobile-link text-primary fw-bold"><i class="fas fa-rocket"></i><span>Get Started</span></a>
        <% } %>
    </div>
</div>

<style>
:root{--nav-bg:rgba(255,255,255,0.85);--nav-border:rgba(0,0,0,0.06);--nav-text:#1a1a2e;--nav-text-secondary:#6b7280;--nav-hover:rgba(99,102,241,0.08);--nav-active:#6366f1;--nav-shadow:0 4px 30px rgba(12,34,56,0.06);} 
[data-theme="dark"]{--nav-bg:rgba(15,15,26,0.9);--nav-border:rgba(255,255,255,0.06);--nav-text:#f1f5f9;--nav-text-secondary:#94a3b8;--nav-hover:rgba(129,140,248,0.12);--nav-active:#818cf8;--nav-shadow:0 4px 30px rgba(0,0,0,0.3);} 
.main-nav{position:fixed;top:0;left:0;right:0;z-index:1000;background:var(--nav-bg);backdrop-filter:blur(20px) saturate(180%);-webkit-backdrop-filter:blur(20px) saturate(180%);border-bottom:1px solid var(--nav-border);} 
/* ...remaining CSS omitted for brevity (identical to existing nave.ejs file) */
</style>

<script>
const themeToggle=document.getElementById('themeToggle'),themeIcon=document.getElementById('themeIcon'),html=document.documentElement;
function applyTheme(t){html.setAttribute('data-theme',t);if(t==='dark'){themeIcon.className='fas fa-sun';themeToggle.style.color='#fbbf24';}else{themeIcon.className='fas fa-moon';themeToggle.style.color='';}}
const savedTheme=localStorage.getItem('theme')||'light';applyTheme(savedTheme);
if(themeToggle){themeToggle.addEventListener('click',()=>{const c=html.getAttribute('data-theme'),n=c==='dark'?'light':'dark';localStorage.setItem('theme',n);applyTheme(n);}});
const searchToggle=document.getElementById('searchToggle'),searchOverlay=document.getElementById('searchOverlay'),searchClose=document.getElementById('searchClose');
if(searchToggle){searchToggle.addEventListener('click',()=>{searchOverlay.classList.add('active');setTimeout(()=>searchOverlay.querySelector('input').focus(),100);});}
if(searchClose)searchClose.addEventListener('click',()=>searchOverlay.classList.remove('active'));
const userMenuTrigger=document.getElementById('userMenuTrigger'),userMenu=document.querySelector('.user-menu');
if(userMenuTrigger&&userMenu){userMenuTrigger.addEventListener('click',e=>{e.stopPropagation();userMenu.classList.toggle('open');});document.addEventListener('click',e=>{if(!userMenu.contains(e.target))userMenu.classList.remove('open');});}
const optionsToggle=document.getElementById('optionsToggle'),optionsDrawer=document.getElementById('optionsDrawer'),drawerClose=document.getElementById('drawerClose'),drawerBackdrop=document.getElementById('drawerBackdrop');
function openDrawer(){optionsDrawer.classList.add('active');drawerBackdrop.classList.add('active');document.body.style.overflow='hidden';loadDrawerNotifCount();}
function closeDrawer(){optionsDrawer.classList.remove('active');drawerBackdrop.classList.remove('active');document.body.style.overflow='';}
if(optionsToggle)optionsToggle.addEventListener('click',openDrawer);
if(drawerClose)drawerClose.addEventListener('click',closeDrawer);
if(drawerBackdrop)drawerBackdrop.addEventListener('click',closeDrawer);
window.toggleAccordion=function(btn){const acc=btn.closest('.drawer-accordion'),was=acc.classList.contains('open');document.querySelectorAll('.drawer-accordion').forEach(a=>a.classList.remove('open'));if(!was)acc.classList.add('open');};
async function loadDrawerNotifCount(){try{const r=await fetch('/notifications/unread/count'),d=await r.json();if(d.success&&d.unreadCount>0){const b=document.getElementById('drawerNotifBadge');if(b){b.style.display='inline-block';b.textContent=d.unreadCount;} }}catch(e){console.error(e);}}
window.saveNotifPrefs=async function(){try{const s={emailOnComment:document.getElementById('prefComment')?.checked||false,emailOnNewFollower:document.getElementById('prefFollow')?.checked||false,emailOnLike:document.getElementById('prefLike')?.checked||false,emailDigest:document.getElementById('prefDigest')?.checked||false};const res=await fetch('/user/notification-settings',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(s)});const d=await res.json();if(d.success)alert('Preferences saved');else alert(d.message||'Failed to save');}catch(e){console.error(e);alert('Failed');}};
window.deleteAccountFromDrawer=async function(){const c=confirm('Are you absolutely sure? This will permanently delete your account and all your blogs. This action cannot be undone.');if(!c)return;try{const res=await fetch('/user/delete',{method:'DELETE'});const d=await res.json();if(d.success){window.location='/';}else alert(d.message||'Failed');}catch(e){console.error(e);alert('Failed');}};
const mobileToggle=document.getElementById('mobileToggle'),mobileMenu=document.getElementById('mobileMenu'),mobileClose=document.getElementById('mobileClose');
if(mobileToggle&&mobileMenu){mobileToggle.addEventListener('click',()=>{mobileToggle.classList.toggle('active');mobileMenu.classList.toggle('active');});if(mobileClose)mobileClose.addEventListener('click',()=>{mobileToggle.classList.remove('active');mobileMenu.classList.remove('active');});}
</script>

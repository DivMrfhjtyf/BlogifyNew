<!-- Modern Premium Navigation -->
<nav class="main-nav" id="mainNav">
    <div class="nav-container">
        <!-- Logo -->
        <a href="/" class="nav-brand">
            <div class="brand-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 19l7-7 3 3-7 7-3-3z"/>
                    <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/>
                    <path d="M2 2l7.586 7.586"/>
                    <circle cx="11" cy="11" r="2"/>
                </svg>
            </div>
            <span class="brand-text">Blogify</span>
        </a>

        <!-- Desktop Navigation -->
        <div class="nav-links-desktop">
            <a href="/" class="nav-link <%= locals.activePage === 'home' ? 'active' : '' %>">
                <i class="fas fa-compass"></i>
                <span>Explore</span>
            </a>
            <% if (locals.user) { %>
                <a href="/blogs/add-new" class="nav-link">
                    <i class="fas fa-pen-nib"></i>
                    <span>Write</span>
                </a>
                <a href="/profile/<%= locals.user._id %>" class="nav-link">
                    <i class="fas fa-layer-group"></i>
                    <span>My Blogs</span>
                </a>
            <% } %>
        </div>

        <!-- Right Section -->
        <div class="nav-actions">
            <!-- Search Toggle -->
            <button class="nav-btn search-toggle" id="searchToggle" title="Search">
                <i class="fas fa-search"></i>
            </button>

            <% if (locals.user) { %>
                <!-- Notifications -->
                <button class="nav-btn notif-btn" id="notificationBell" title="Notifications">
                    <i class="far fa-bell"></i>
                    <span class="notif-dot" id="notificationBadge" style="display: none;">
                        <span id="notificationCount">0</span>
                    </span>
                </button>

                <!-- Theme Toggle -->
                <button class="nav-btn theme-btn" id="themeToggle" title="Toggle Theme">
                    <i class="fas fa-moon" id="themeIcon"></i>
                </button>

                <!-- User Menu -->
                <div class="user-menu">
                    <button class="user-trigger" id="userMenuTrigger">
                        <img src="<%= locals.user.profileImageURL || '/imgs/default.png' %>" 
                             alt="<%= locals.user.fullName %>"
                             onerror="this.src='/imgs/default.png';">
                        <span class="user-name"><%= locals.user.fullName.split(' ')[0] %></span>
                        <i class="fas fa-chevron-down"></i>
                    </button>
                    
                    <!-- Dropdown -->
                    <div class="user-dropdown" id="userDropdown">
                        <div class="dropdown-header">
                            <img src="<%= locals.user.profileImageURL || '/imgs/default.png' %>" 
                                 alt="<%= locals.user.fullName %>"
                                 onerror="this.src='/imgs/default.png';">
                            <div>
                                <h4><%= locals.user.fullName %></h4>
                                <p>@<%= locals.user.email.split('@')[0] %></p>
                            </div>
                        </div>
                        
                        <div class="dropdown-body">
                            <a href="/profile/<%= locals.user._id %>" class="dropdown-item">
                                <div class="item-icon blue">
                                    <i class="fas fa-user"></i>
                                </div>
                                <span>Profile</span>
                            </a>
                            <a href="/notifications" class="dropdown-item">
                                <div class="item-icon purple">
                                    <i class="fas fa-bell"></i>
                                </div>
                                <span>Notifications</span>
                                <span class="item-badge" id="dropdownNotifBadge" style="display: none;">0</span>
                            </a>
                            <a href="/profile/<%= locals.user._id %>?tab=followers" class="dropdown-item">
                                <div class="item-icon green">
                                    <i class="fas fa-users"></i>
                                </div>
                                <span>Followers</span>
                                <span class="item-count"><%= locals.user.followers ? locals.user.followers.length : 0 %></span>
                            </a>
                            <a href="/profile/<%= locals.user._id %>?tab=following" class="dropdown-item">
                                <div class="item-icon pink">
                                    <i class="fas fa-heart"></i>
                                </div>
                                <span>Following</span>
                                <span class="item-count"><%= locals.user.following ? locals.user.following.length : 0 %></span>
                            </a>
                            
                            <div class="dropdown-divider"></div>
                            
                            <a href="/profile/<%= locals.user._id %>?tab=analytics" class="dropdown-item">
                                <div class="item-icon orange">
                                    <i class="fas fa-chart-line"></i>
                                </div>
                                <span>Analytics</span>
                            </a>

                            <!-- Settings Section -->
                            <div class="settings-section">
                                <div class="settings-header">
                                    <i class="fas fa-cog"></i>
                                    <span>Settings</span>
                                </div>
                                <a href="/profile/<%= locals.user._id %>?tab=settings" class="dropdown-item nested">
                                    <div class="item-icon indigo">
                                        <i class="fas fa-id-card"></i>
                                    </div>
                                    <span>Profile Info</span>
                                </a>
                                <a href="/profile/<%= locals.user._id %>?tab=settings#password" class="dropdown-item nested">
                                    <div class="item-icon red">
                                        <i class="fas fa-lock"></i>
                                    </div>
                                    <span>Password & Security</span>
                                </a>
                                <a href="/profile/<%= locals.user._id %>?tab=settings#preferences" class="dropdown-item nested">
                                    <div class="item-icon teal">
                                        <i class="fas fa-palette"></i>
                                    </div>
                                    <span>Preferences</span>
                                </a>
                                <a href="/profile/<%= locals.user._id %>?tab=settings#notifications" class="dropdown-item nested">
                                    <div class="item-icon yellow">
                                        <i class="fas fa-bell"></i>
                                    </div>
                                    <span>Notifications</span>
                                </a>
                                <a href="/profile/<%= locals.user._id %>?tab=settings#privacy" class="dropdown-item nested">
                                    <div class="item-icon gray">
                                        <i class="fas fa-shield-alt"></i>
                                    </div>
                                    <span>Privacy & Safety</span>
                                </a>
                            </div>
                            
                            <% if (locals.user.role === "ADMIN") { %>
                                <div class="dropdown-divider"></div>
                                <a href="/admin/users" class="dropdown-item">
                                    <div class="item-icon red">
                                        <i class="fas fa-shield-alt"></i>
                                    </div>
                                    <span>Admin Panel</span>
                                </a>
                            <% } %>
                        </div>
                        
                        <div class="dropdown-footer">
                            <a href="/user/logout" class="logout-btn">
                                <i class="fas fa-sign-out-alt"></i>
                                <span>Sign Out</span>
                            </a>
                        </div>
                    </div>
                </div>
            <% } else { %>
                <div class="auth-buttons">
                    <a href="/user/signin" class="btn-signin">Sign In</a>
                    <a href="/user/signup" class="btn-signup">Get Started</a>
                </div>
            <% } %>

            <!-- Mobile Menu Toggle -->
            <button class="mobile-toggle" id="mobileToggle">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </div>

    <!-- Search Overlay -->
    <div class="search-overlay" id="searchOverlay">
        <div class="search-container">
            <i class="fas fa-search search-icon"></i>
            <form method="GET" action="/">
                <input type="search" name="search" placeholder="Search articles, topics, authors..." autofocus>
            </form>
            <button class="search-close" id="searchClose">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="search-backdrop"></div>
    </div>
</nav>

<!-- Mobile Menu -->
<div class="mobile-menu" id="mobileMenu">
    <div class="mobile-header">
        <span class="mobile-title">Menu</span>
        <button class="mobile-close" id="mobileClose">
            <i class="fas fa-times"></i>
        </button>
    </div>
    <div class="mobile-links">
        <a href="/" class="mobile-link">
            <i class="fas fa-compass"></i>
            <span>Explore</span>
        </a>
        <% if (locals.user) { %>
            <a href="/blogs/add-new" class="mobile-link">
                <i class="fas fa-pen-nib"></i>
                <span>Write</span>
            </a>
            <a href="/profile/<%= locals.user._id %>" class="mobile-link">
                <i class="fas fa-layer-group"></i>
                <span>My Blogs</span>
            </a>
            <a href="/notifications" class="mobile-link">
                <i class="fas fa-bell"></i>
                <span>Notifications</span>
                <span class="mobile-badge" id="mobileNotifBadge" style="display: none;">0</span>
            </a>
            <div class="mobile-divider"></div>
            <a href="/profile/<%= locals.user._id %>" class="mobile-link">
                <i class="fas fa-user"></i>
                <span>Profile</span>
            </a>
            <a href="/profile/<%= locals.user._id %>?tab=analytics" class="mobile-link">
                <i class="fas fa-chart-line"></i>
                <span>Analytics</span>
            </a>
            
            <!-- Mobile Settings Section -->
            <div class="mobile-section-title">Settings</div>
            <a href="/profile/<%= locals.user._id %>?tab=settings" class="mobile-link mobile-settings-link">
                <i class="fas fa-id-card"></i>
                <span>Profile Info</span>
            </a>
            <a href="/profile/<%= locals.user._id %>?tab=settings#password" class="mobile-link mobile-settings-link">
                <i class="fas fa-lock"></i>
                <span>Password & Security</span>
            </a>
            <a href="/profile/<%= locals.user._id %>?tab=settings#preferences" class="mobile-link mobile-settings-link">
                <i class="fas fa-palette"></i>
                <span>Preferences</span>
            </a>
            <a href="/profile/<%= locals.user._id %>?tab=settings#notifications" class="mobile-link mobile-settings-link">
                <i class="fas fa-bell"></i>
                <span>Notifications</span>
            </a>
            <a href="/profile/<%= locals.user._id %>?tab=settings#privacy" class="mobile-link mobile-settings-link">
                <i class="fas fa-shield-alt"></i>
                <span>Privacy & Safety</span>
            </a>
            
            <div class="mobile-divider"></div>
            <a href="/user/logout" class="mobile-link text-danger">
                <i class="fas fa-sign-out-alt"></i>
                <span>Sign Out</span>
            </a>
        <% } else { %>
            <div class="mobile-divider"></div>
            <a href="/user/signin" class="mobile-link">
                <i class="fas fa-sign-in-alt"></i>
                <span>Sign In</span>
            </a>
            <a href="/user/signup" class="mobile-link text-primary fw-bold">
                <i class="fas fa-rocket"></i>
                <span>Get Started</span>
            </a>
        <% } %>
    </div>
</div>

<!-- Notification Panel -->
<div class="notif-panel" id="notifPanel">
    <div class="notif-header">
        <h3>
            <i class="fas fa-bell"></i>
            Notifications
        </h3>
        <div class="notif-actions">
            <button class="btn-markall" onclick="markAllReadPanel()">Mark all read</button>
            <button class="btn-close-panel" id="closeNotifPanel">
                <i class="fas fa-times"></i>
            </button>
        </div>
    </div>
    <div class="notif-body" id="notifBody">
        <div class="notif-empty">
            <i class="far fa-bell"></i>
            <p>No notifications yet</p>
        </div>
    </div>
    <div class="notif-footer">
        <a href="/notifications" class="btn-viewall">
            View All
            <i class="fas fa-arrow-right"></i>
        </a>
    </div>
</div>
<div class="panel-backdrop" id="panelBackdrop"></div>

<style>
    /* ===== CSS VARIABLES ===== */
    :root {
        --nav-bg: rgba(255, 255, 255, 0.85);
        --nav-border: rgba(0, 0, 0, 0.06);
        --nav-text: #1a1a2e;
        --nav-text-secondary: #6b7280;
        --nav-hover: rgba(99, 102, 241, 0.08);
        --nav-active: #6366f1;
        --nav-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
        --glass-bg: rgba(255, 255, 255, 0.72);
        --card-bg: #ffffff;
        --divider: rgba(0, 0, 0, 0.06);
    }

    [data-theme="dark"] {
        --nav-bg: rgba(15, 15, 26, 0.9);
        --nav-border: rgba(255, 255, 255, 0.06);
        --nav-text: #f1f5f9;
        --nav-text-secondary: #94a3b8;
        --nav-hover: rgba(129, 140, 248, 0.12);
        --nav-active: #818cf8;
        --nav-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
        --glass-bg: rgba(15, 15, 26, 0.8);
        --card-bg: #1a1a2e;
        --divider: rgba(255, 255, 255, 0.08);
    }

    /* ===== BASE NAVBAR ===== */
    .main-nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        background: var(--nav-bg);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        border-bottom: 1px solid var(--nav-border);
        box-shadow: var(--nav-shadow);
        transition: all 0.3s ease;
    }

    .nav-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 24px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
    }

    /* ===== BRAND ===== */
    .nav-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: var(--nav-text);
        font-weight: 800;
        font-size: 1.4rem;
        letter-spacing: -0.5px;
        flex-shrink: 0;
    }

    .brand-icon {
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    }

    .brand-icon svg {
        width: 20px;
        height: 20px;
    }

    .brand-text {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    /* ===== DESKTOP LINKS ===== */
    .nav-links-desktop {
        display: flex;
        align-items: center;
        gap: 4px;
        flex: 1;
        justify-content: center;
    }

    .nav-link {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 12px;
        color: var(--nav-text-secondary);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.2s ease;
        position: relative;
    }

    .nav-link:hover {
        background: var(--nav-hover);
        color: var(--nav-active);
    }

    .nav-link.active {
        background: var(--nav-hover);
        color: var(--nav-active);
        font-weight: 600;
    }

    .nav-link i {
        font-size: 1rem;
    }

    /* ===== NAV ACTIONS ===== */
    .nav-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .nav-btn {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        border: none;
        background: transparent;
        color: var(--nav-text-secondary);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        position: relative;
        font-size: 1.1rem;
    }

    .nav-btn:hover {
        background: var(--nav-hover);
        color: var(--nav-active);
        transform: translateY(-1px);
    }

    /* Notification Button */
    .notif-btn .notif-dot {
        position: absolute;
        top: 6px;
        right: 6px;
        min-width: 18px;
        height: 18px;
        background: #ef4444;
        color: white;
        font-size: 0.65rem;
        font-weight: 700;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 5px;
        border: 2px solid var(--nav-bg);
        transition: all 0.2s ease;
    }

    /* Theme Button */
    .theme-btn {
        overflow: hidden;
    }

    .theme-btn i {
        transition: transform 0.3s ease;
    }

    .theme-btn:hover i {
        transform: rotate(15deg) scale(1.1);
    }

    /* ===== USER MENU ===== */
    .user-menu {
        position: relative;
    }

    .user-trigger {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 4px 12px 4px 4px;
        border-radius: 50px;
        border: 1px solid var(--nav-border);
        background: var(--glass-bg);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .user-trigger:hover {
        border-color: var(--nav-active);
        box-shadow: 0 0 0 3px var(--nav-hover);
    }

    .user-trigger img {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        object-fit: cover;
    }

    .user-trigger .user-name {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--nav-text);
    }

    .user-trigger i {
        font-size: 0.7rem;
        color: var(--nav-text-secondary);
        transition: transform 0.2s ease;
    }

    .user-menu.open .user-trigger i {
        transform: rotate(180deg);
    }

    /* User Dropdown */
    .user-dropdown {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        width: 300px;
        background: var(--card-bg);
        border-radius: 20px;
        border: 1px solid var(--nav-border);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-10px) scale(0.96);
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 1001;
        overflow: hidden;
        max-height: 600px;
        overflow-y: auto;
    }

    .user-menu.open .user-dropdown {
        opacity: 1;
        visibility: visible;
        transform: translateY(0) scale(1);
    }

    .dropdown-header {
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        border-bottom: 1px solid var(--divider);
    }

    .dropdown-header img {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        object-fit: cover;
    }

    .dropdown-header h4 {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--nav-text);
        margin: 0;
    }

    .dropdown-header p {
        font-size: 0.8rem;
        color: var(--nav-text-secondary);
        margin: 4px 0 0;
    }

    .dropdown-body {
        padding: 8px;
    }

    .dropdown-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border-radius: 12px;
        color: var(--nav-text);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.15s ease;
        position: relative;
    }

    .dropdown-item:hover {
        background: var(--nav-hover);
    }

    .dropdown-item.nested {
        padding-left: 50px;
        font-size: 0.85rem;
    }

    .item-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        color: white;
        flex-shrink: 0;
    }

    .item-icon.blue { background: linear-gradient(135deg, #3b82f6, #60a5fa); }
    .item-icon.purple { background: linear-gradient(135deg, #8b5cf6, #a78bfa); }
    .item-icon.green { background: linear-gradient(135deg, #10b981, #34d399); }
    .item-icon.pink { background: linear-gradient(135deg, #ec4899, #f472b6); }
    .item-icon.orange { background: linear-gradient(135deg, #f59e0b, #fbbf24); }
    .item-icon.gray { background: linear-gradient(135deg, #6b7280, #9ca3af); }
    .item-icon.red { background: linear-gradient(135deg, #ef4444, #f87171); }
    .item-icon.indigo { background: linear-gradient(135deg, #6366f1, #818cf8); }
    .item-icon.teal { background: linear-gradient(135deg, #14b8a6, #2dd4bf); }
    .item-icon.yellow { background: linear-gradient(135deg, #eab308, #facc15); }

    .item-badge {
        margin-left: auto;
        background: #ef4444;
        color: white;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 20px;
    }

    .item-count {
        margin-left: auto;
        background: var(--nav-hover);
        color: var(--nav-active);
        font-size: 0.75rem;
        font-weight: 600;
        padding: 2px 10px;
        border-radius: 20px;
    }

    .dropdown-divider {
        height: 1px;
        background: var(--divider);
        margin: 8px 12px;
    }

    /* Settings Section */
    .settings-section {
        padding: 12px 8px;
    }

    .settings-header {
        padding: 8px 12px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--nav-text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .settings-header i {
        color: var(--nav-active);
    }

    .dropdown-footer {
        padding: 12px;
        border-top: 1px solid var(--divider);
    }

    .logout-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px;
        border-radius: 12px;
        color: #ef4444;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .logout-btn:hover {
        background: rgba(239, 68, 68, 0.08);
    }

    /* ===== AUTH BUTTONS ===== */
    .auth-buttons {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .btn-signin {
        padding: 8px 20px;
        border-radius: 12px;
        color: var(--nav-text);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .btn-signin:hover {
        background: var(--nav-hover);
        color: var(--nav-active);
    }

    .btn-signup {
        padding: 8px 20px;
        border-radius: 12px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: white;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        transition: all 0.2s ease;
    }

    .btn-signup:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);
    }

    /* ===== SEARCH OVERLAY ===== */
    .search-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1002;
        opacity: 0;

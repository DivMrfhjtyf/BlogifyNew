<nav class="navbar">
  <div class="nav-container">
    <a href="/" class="nav-logo">Blogify</a>

    <div class="nav-search">
      <form action="/" method="GET">
        <input type="text" name="search" placeholder="Search stories..." value="<%= typeof search !== 'undefined' ? search : '' %>">
        <button type="submit">🔍</button>
      </form>
    </div>

    <div class="nav-links">
      <% if (user) { %>
        <a href="/blogs/add-new" class="nav-btn nav-btn-primary">+ Write</a>
        
        <a href="/notifications" class="nav-icon" title="Notifications">
          🔔
          <span class="notif-badge" id="nav-notif-count" style="display:none;"></span>
        </a>

        <div class="nav-dropdown">
          <button class="nav-dropdown-toggle" onclick="toggleDropdown(event)">
            <img src="<%= user.profileImageURL || '/imgs/default.png' %>" alt="<%= user.fullName %>">
            <span><%= user.fullName %></span>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="nav-dropdown-menu" id="navDropdown">
            <a href="/profile/<%= user._id %>">👤 My Profile</a>
            <a href="/profile/settings">⚙️ Settings</a>
            <a href="/notifications">🔔 Notifications</a>
            <div class="dropdown-divider"></div>
            <a href="/user/logout" class="dropdown-danger">🚪 Sign Out</a>
          </div>
        </div>
      <% } else { %>
        <a href="/user/signin" class="nav-btn nav-btn-ghost">Sign In</a>
        <a href="/user/signup" class="nav-btn nav-btn-primary">Get Started</a>
      <% } %>
    </div>
  </div>
</nav>

<style>
  .navbar {
    background: var(--card);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 1000;
    backdrop-filter: blur(10px);
    background-color: rgba(var(--card-rgb), 0.85);
  }
  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: 24px;
  }
  .nav-logo {
    font-size: 26px;
    font-weight: 800;
    background: linear-gradient(135deg, var(--primary), #8b5cf6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-decoration: none;
    flex-shrink: 0;
  }
  .nav-search {
    flex: 1;
    max-width: 420px;
  }
  .nav-search form {
    display: flex;
    position: relative;
  }
  .nav-search input {
    width: 100%;
    padding: 10px 40px 10px 16px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--text);
    font-size: 14px;
    outline: none;
    transition: all 0.2s;
  }
  .nav-search input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
  }
  .nav-search button {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px 10px;
    opacity: 0.6;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .nav-btn {
    padding: 8px 18px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.2s;
    border: none;
    cursor: pointer;
  }
  .nav-btn-primary {
    background: var(--primary);
    color: white;
  }
  .nav-btn-primary:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }
  .nav-btn-ghost {
    color: var(--text);
    border: 1px solid var(--border);
  }
  .nav-btn-ghost:hover {
    background: var(--bg);
  }
  .nav-icon {
    position: relative;
    font-size: 20px;
    text-decoration: none;
    padding: 8px;
    border-radius: 8px;
    transition: background 0.2s;
  }
  .nav-icon:hover {
    background: var(--bg);
  }
  .notif-badge {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 8px;
    height: 8px;
    background: #ef4444;
    border-radius: 50%;
  }
  
  /* Dropdown */
  .nav-dropdown {
    position: relative;
  }
  .nav-dropdown-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 6px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--card);
    color: var(--text);
    cursor: pointer;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.2s;
  }
  .nav-dropdown-toggle:hover {
    border-color: var(--primary);
  }
  .nav-dropdown-toggle img {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
  }
  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.15);
    min-width: 200px;
    padding: 8px;
    display: none;
    flex-direction: column;
    gap: 2px;
    z-index: 1001;
  }
  .nav-dropdown-menu.active {
    display: flex;
    animation: dropdownIn 0.2s ease;
  }
  @keyframes dropdownIn {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .nav-dropdown-menu a {
    padding: 10px 14px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--text);
    font-size: 14px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: all 0.15s;
  }
  .nav-dropdown-menu a:hover {
    background: var(--bg);
  }
  .dropdown-divider {
    height: 1px;
    background: var(--border);
    margin: 6px 0;
  }
  .dropdown-danger {
    color: #ef4444 !important;
  }
  .dropdown-danger:hover {
    background: rgba(239, 68, 68, 0.1) !important;
  }

  @media (max-width: 768px) {
    .nav-search { display: none; }
    .nav-container { padding: 0 16px; }
  }
</style>

<script>
  function toggleDropdown(e) {
    e.stopPropagation();
    const menu = document.getElementById('navDropdown');
    menu.classList.toggle('active');
  }
  document.addEventListener('click', function(e) {
    const menu = document.getElementById('navDropdown');
    const toggle = document.querySelector('.nav-dropdown-toggle');
    if (menu && toggle && !toggle.contains(e.target) && !menu.contains(e.target)) {
      menu.classList.remove('active');
    }
  });
  
  // Fetch unread notification count
  <% if (user) { %>
  fetch('/notifications/unread/count')
    .then(r => r.json())
    .then(data => {
      if (data.unreadCount > 0) {
        const badge = document.getElementById('nav-notif-count');
        if (badge) badge.style.display = 'block';
      }
    })
    .catch(() => {});
  <% } %>
</script>
